# Single administrator account. These are read only on the server.
# Copy to .env.local (never commit it) and fill in real values.

# Login username for the only authorized user.
ADMIN_USERNAME=admin

# scrypt hash of the admin password. Generate with:
#   npm run hash-password
# Never put the plain password here.
ADMIN_PASSWORD_HASH=

# Name shown in the header (display only).
ADMIN_DISPLAY_NAME=נתנאל

# Random secret (at least 32 characters) used to sign session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional: where your own financial data is saved (JSON). Default: ./data/finance.json (gitignored).
# DATA_FILE=/Users/you/finance-data/finance.json

# Only set this to 1 if the app runs behind a reverse proxy that overwrites X-Forwarded-For.
# Otherwise that header comes from the browser and could be faked to dodge the login limit.
# TRUST_PROXY=1

# Hosted on Vercel: connect Upstash Redis in the project's Storage tab and Vercel sets these for you.
# With them set, data, backups, login lockouts and logout live in that database instead of local files.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
